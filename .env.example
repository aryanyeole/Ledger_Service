# Host-side addresses use 127.0.0.1, not localhost: Windows resolves localhost to ::1 first, Compose publishes on
# 127.0.0.1 only (D-029), and redis-py's 200 ms connect timeout expires before it falls back. Containers keep service names.
# Postgres (container exposed on host 5433, D-013)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=ledger
# Superuser: runs infra/postgres/init and admin psql only; no service connects as it.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me
# Application roles, created by infra/postgres/init/01-roles.sh on an empty volume.
# Changing these later needs `docker compose down -v` (or ALTER ROLE by hand).
LEDGER_API_OWNER_PASSWORD=change-me-owner
LEDGER_API_APP_PASSWORD=change-me-app
SETTLEMENT_WORKER_PASSWORD=change-me-worker
# Kafka (host listener)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
