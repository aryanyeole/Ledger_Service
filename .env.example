# Postgres (container exposed on host 5433, D-013)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ledger
# Superuser: runs infra/postgres/init and admin psql only; no service connects as it.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me
# Application roles, created by infra/postgres/init/01-roles.sh on an empty volume.
# Changing these later needs `docker compose down -v` (or ALTER ROLE by hand).
LEDGER_API_OWNER_PASSWORD=change-me-owner
LEDGER_API_APP_PASSWORD=change-me-app
SETTLEMENT_WORKER_PASSWORD=change-me-worker
# Kafka (host listener)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
